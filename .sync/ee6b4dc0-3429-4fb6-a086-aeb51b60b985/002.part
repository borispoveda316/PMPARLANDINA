nternalId":"d3bd80b1-5e71-4cab-aacb-d05c69286d1a","Variable":"Internacionalización","Indicador":"Número de Publicaciones en Coautoría Internacional","Descripción Indicador":"Cantidad de publicaciones académicas realizadas en colaboración con investigadores de instituciones internacionales.","Fórmula de cálculo":"NPCI = Σ publicaciones con al menos un coautor afiliado a una institución extranjera (misma fuente que IN-09)","Actividad":"Unificar la fuente con el indicador IN-09 y reportar","Responsable":"Dirección de Investigación\nDirección de Relaciones Internacionales"},{"@odata.etag":"","ItemInternalId":"5b1da1c2-7ced-4de2-9184-8f5d8787ad90","Variable":"Internacionalización","Indicador":"Número de Publicaciones en Coautoría Internacional","Descripción Indicador":"Cantidad de publicaciones académicas realizadas en colaboración con investigadores de instituciones internacionales.","Fórmula de cálculo":"NPCI = Σ publicaciones con al menos un coautor afiliado a una institución extranjera (misma fuente que IN-09)","Actividad":"Fomentar la coautoría internacional","Responsable":"Vicerrectorado de Investigación\nDirección de Relaciones Internacionales"},{"@odata.etag":"","ItemInternalId":"0fceb5fe-028d-4919-a587-3adf7377680d","Variable":"Internacionalización","Indicador":"Estudiantes Internacionales en la Universidad","Descripción Indicador":"Porcentaje de estudiantes internacionales matriculados en\nprogramas de la universidad.","Fórmula de cálculo":"EIU = (Número de estudiantes internacionales / Total de estudiantes\nmatriculados) x 100.","Actividad":"Registrar la condición de estudiante internacional en la matrícula","Responsable":"Dirección de Relaciones Internacionales\nSecretaría General"},{"@odata.etag":"","ItemInternalId":"a5ba9846-9799-4bd9-932d-efbfb652dee9","Variable":"Internacionalización","Indicador":"Estudiantes Internacionales en la Universidad","Descripción Indicador":"Porcentaje de estudiantes internacionales matriculados en\nprogramas de la universidad.","Fórmula de cálculo":"EIU = (Número de estudiantes internacionales / Total de estudiantes\nmatriculados) x 100.","Actividad":"Ejecutar la estrategia de captación de estudiantes internacionales","Responsable":"Dirección de Relaciones Internacionales"},{"@odata.etag":"","ItemInternalId":"df7313f8-db59-4808-8163-fe919df80582","Variable":"Internacionalización","Indicador":"Participación en Conferencias y Simposios Internacionales","Descripción Indicador":"Número de presentaciones o participaciones de docentes y\nestudiantes en conferencias o simposios internacionales.","Fórmula de cálculo":"NPCS = Participaciones de docentes + Participaciones de estudiantes en conferencias o simposios internacionales en el año","Actividad":"Registrar las participaciones diferenciando docentes y estudiantes","Responsable":"Dirección de Investigación\nDirección de Relaciones Internacionales"},{"@odata.etag":"","ItemInternalId":"a1e934d2-946b-4c43-b539-c86eb677f6ef","Variable":"Internacionalización","Indicador":"Participación en Conferencias y Simposios Internacionales","Descripción Indicador":"Número de presentaciones o participaciones de docentes y\nestudiantes en conferencias o simposios internacionales.","Fórmula de cálculo":"NPCS = Participaciones de docentes + Participaciones de estudiantes en conferencias o simposios internacionales en el año","Actividad":"Crear un fondo concursable para ponencias estudiantiles internacionales","Responsable":"Vicerrectorado de Investigación\nDirección de Relaciones Internacionales"},{"@odata.etag":"","ItemInternalId":"88101765-58dc-44a1-9112-27df02a81d54","Variable":"Internacionalización","Indicador":"Proyectos de Investigación Internacionales","Descripción Indicador":"Número de proyectos de investigación desarrollados en colaboración con instituciones o investigadores internacionales.","Fórmula de cálculo":"NPII = Σ proyectos de investigación en curso desarrollados en colaboración con instituciones o investigadores internacionales","Actividad":"Lanzar la convocatoria interna de proyectos con contraparte internacional","Responsable":"Vicerrectorado de Investigación\nDirección de Relaciones Internacionales"},{"@odata.etag":"","ItemInternalId":"f604e226-af80-43c5-a525-6d3cb7a3ff71","Variable":"Internacionalización","Indicador":"Incorporación de Contenidos Globales e Interculturales en el Currículo","Descripción Indicador":"Proporción de programas académicos que incluyen contenidos internacionales, interculturales o globales en su plan de estudios.","Fórmula de cálculo":"PCGI = (NPCI / TP) x 100","Actividad":"Identificar los programas con contenidos internacionales o interculturales","Responsable":"Vicerrectorado Académico\nDirección de Relaciones Internacionales"},{"@odata.etag":"","ItemInternalId":"688ea8b8-4250-45d7-b2f3-b50db5d7f4f1","Variable":"Internacionalización","Indicador":"Incorporación de Contenidos Globales e Interculturales en el Currículo","Descripción Indicador":"Proporción de programas académicos que incluyen contenidos internacionales, interculturales o globales en su plan de estudios.","Fórmula de cálculo":"PCGI = (NPCI / TP) x 100","Actividad":"Implementar la Cátedra de Derecho Comunitario Andino (optativa institucional)","Responsable":"Vicerrectorado Académico\nDirección de Relaciones Internacionales"},{"@odata.etag":"","ItemInternalId":"5f66fe8c-ad42-4acf-a304-c7c885b0c807","Variable":"Internacionalización","Indicador":"Incorporación de Contenidos Globales e Interculturales en el Currículo","Descripción Indicador":"Proporción de programas académicos que incluyen contenidos internacionales, interculturales o globales en su plan de estudios.","Fórmula de cálculo":"PCGI = (NPCI / TP) x 100","Actividad":"Incorporar resultados de aprendizaje internacionales en los programas","Responsable":"Vicerrectorado Académico\nDirección de Relaciones Internacionales"},{"@odata.etag":"","ItemInternalId":"883e01a7-5fa9-467f-a948-d50e70ec4efc","Variable":"Internacionalización","Indicador":"Plan de Acción para Internacionalización","Descripción Indicador":"Existencia y aplicación de un plan estratégico formalmente definido que incluya metas, indicadores y acciones para fortalecer la internacionalización.","Fórmula de cálculo":"CPAI = (Metas del plan de internacionalización alcanzadas / Metas programadas) x 100","Actividad":"Formular y aprobar el Plan de Acción de Internacionalización","Responsable":"Dirección de Relaciones Internacionales"},{"@odata.etag":"","ItemInternalId":"d865e7aa-a2e1-4bd0-a842-b11e56ab40c9","Variable":"Internacionalización","Indicador":"Plan de Acción para Internacionalización","Descripción Indicador":"Existencia y aplicación de un plan estratégico formalmente definido que incluya metas, indicadores y acciones para fortalecer la internacionalización.","Fórmula de cálculo":"CPAI = (Metas del plan de internacionalización alcanzadas / Metas programadas) x 100","Actividad":"Evaluar el cumplimiento anual del plan","Responsable":"Dirección de Relaciones Internacionales"},{"@odata.etag":"","ItemInternalId":"6314d3a5-b055-4621-8fc6-71c34ca0e314","Variable":"Internacionalización","Indicador":"Entrega de Becas de Movilidad Internacional","Descripción Indicador":"Número de becas otorgadas a estudiantes y docentes para realizar estudios, pasantías o estancias en instituciones extranjeras.","Fórmula de cálculo":"NBMI = Becas de movilidad presencial + Becas de movilidad virtual otorgadas en el periodo (desagregadas por estudiantes y docentes)","Actividad":"Estructurar el registro de becas de movilidad","Responsable":"Dirección de Bienestar Universitario\nDirección de Relaciones Internacionales"},{"@odata.etag":"","ItemInternalId":"a5f6eb3b-f924-4287-9508-ce82114dfba1","Variable":"Internacionalización","Indicador":"Entrega de Becas de Movilidad Internacional","Descripción Indicador":"Número de becas otorgadas a estudiantes y docentes para realizar estudios, pasantías o estancias en instituciones extranjeras.","Fórmula de cálculo":"NBMI = Becas de movilidad presencial + Becas de movilidad virtual otorgadas en el periodo (desagregadas por estudiantes y docentes)","Actividad":"Aprobar el reglamento de becas y ayudas de movilidad internacional","Responsable":"Dirección de Bienestar Universitario\nDirección de Relaciones Internacionales"},{"@odata.etag":"","ItemInternalId":"8fdc0631-9390-46b6-ad18-67d64c5b11c1","Variable":"Internacionalización","Indicador":"Colaboración Internacional con el Sector Público y Privado","Descripción Indicador":"Número de convenios y proyectos activos con entidades públicas y privadas internacionales que promuevan la investigación, formación académica o desarrollo tecnológico.","Fórmula de cálculo":"NCSP = Convenios y proyectos con entidades públicas internacionales + Convenios y proyectos con entidades privadas internacionales","Actividad":"Identificar los convenios y proyectos con entidades públicas y privadas internacionales","Responsable":"Dirección de Relaciones Internacionales\nDirección de Investigación"},{"@odata.etag":"","ItemInternalId":"f01f2017-d90e-4f0e-8f14-47c845562e9c","Variable":"Internacionalización","Indicador":"Colaboración Internacional con el Sector Público y Privado","Descripción Indicador":"Número de convenios y proyectos activos con entidades públicas y privadas internacionales que promuevan la investigación, formación académica o desarrollo tecnológico.","Fórmula de cálculo":"NCSP = Convenios y proyectos con entidades públicas internacionales + Convenios y proyectos con entidades privadas internacionales","Actividad":"Suscribir convenios con organismos de cooperación y empresas internacionales","Responsable":"Dirección de Relaciones Internacionales\nDirección de Investigación"},{"@odata.etag":"","ItemInternalId":"2c983de7-03cc-44f7-b956-ec246f1ca5f1","Variable":"Estrategia y Liderazgo Institucional","Indicador":"Grado de Cumplimiento del Plan Estratégico","Descripción Indicador":"Evaluación del grado de cumplimiento de los objetivos establecidos en el plan estratégico.","Fórmula de cálculo":"GCPE = (Metas del plan estratégico alcanzadas en el año / Total de metas programadas) x 100","Actividad":"Implementar el tablero de seguimiento del plan estratégico","Responsable":"Dirección de Gestión Estrategica"},{"@odata.etag":"","ItemInternalId":"736848d2-0cb4-473d-ad29-6b6085419402","Variable":"Estrategia y Liderazgo Institucional","Indicador":"Grado de Cumplimiento del Plan Estratégico","Descripción Indicador":"Evaluación del grado de cumplimiento de los objetivos establecidos en el plan estratégico.","Fórmula de cálculo":"GCPE = (Metas del plan estratégico alcanzadas en el año / Total de metas programadas) x 100","Actividad":"Elaborar la revisión anual de cumplimiento del plan estratégico","Responsable":"Dirección de Gestión Estrategica"},{"@odata.etag":"","ItemInternalId":"1c75e561-8755-460a-902f-d91790f04058","Variable":"Estrategia y Liderazgo Institucional","Indicador":"Participación en la Toma de Decisiones","Descripción Indicador":"Proporción de actores institucionales (estudiantes, docentes, administrativos) que participan en los órganos de gobierno y toma de decisiones.","Fórmula de cálculo":"PTD = (NPOG / TAI) x 100","Actividad":"Analizar la composición de los órganos de gobierno","Responsable":"Secretaría General"},{"@odata.etag":"","ItemInternalId":"26299107-83ea-4e54-9bb9-7ced1ae2371a","Variable":"Estrategia y Liderazgo Institucional","Indicador":"Participación en la Toma de Decisiones","Descripción Indicador":"Proporción de actores institucionales (estudiantes, docentes, administrativos) que participan en los órganos de gobierno y toma de decisiones.","Fórmula de cálculo":"PTD = (NPOG / TAI) x 100","Actividad":"Proponer mecanismos de participación ampliada","Responsable":"Secretaría General"},{"@odata.etag":"","ItemInternalId":"a5eed0da-fed1-42fc-8fad-c2be676a5d1d","Variable":"Estrategia y Liderazgo Institucional","Indicador":"Satisfacción con el Liderazgo Institucional","Descripción Indicador":"Nivel de satisfacción de la comunidad universitaria con el\nliderazgo institucional y la gestión universitaria.","Fórmula de cálculo":"ISLI = (Encuestados satisfechos con el liderazgo (≥4 en escala 1–5) / Total de encuestados de la comunidad universitaria) x 100","Actividad":"Diseñar la encuesta anual de satisfacción institucional","Responsable":"Jefatura de Servicio al Usuario"},{"@odata.etag":"","ItemInternalId":"d6b130e6-c687-4a04-9a44-1ba20fdbfef1","Variable":"Estrategia y Liderazgo Institucional","Indicador":"Satisfacción con el Liderazgo Institucional","Descripción Indicador":"Nivel de satisfacción de la comunidad universitaria con el\nliderazgo institucional y la gestión universitaria.","Fórmula de cálculo":"ISLI = (Encuestados satisfechos con el liderazgo (≥4 en escala 1–5) / Total de encuestados de la comunidad universitaria) x 100","Actividad":"Aplicar la encuesta y elaborar el plan de acción","Responsable":"Jefatura de Servicio al Usuario"},{"@odata.etag":"","ItemInternalId":"2f17124b-efee-4e8b-b940-3a41715f7d56","Variable":"Estrategia y Liderazgo Institucional","Indicador":"Capacitación y Desarrollo de Líderes Académicos","Descripción Indicador":"Porcentaje de líderes académicos (directores, decanos, etc.) que participan en programas de formación en liderazgo y gestión educativa.","Fórmula de cálculo":"CDLA = (NLC / TL) x 100","Actividad":"Diseñar el programa de formación en liderazgo y gestión educativa","Responsable":"Dirección de Talento Humano"},{"@odata.etag":"","ItemInternalId":"2d8c5432-b935-463b-99c8-70b97b1386d9","Variable":"Estrategia y Liderazgo Institucional","Indicador":"Capacitación y Desarrollo de Líderes Académicos","Descripción Indicador":"Porcentaje de líderes académicos (directores, decanos, etc.) que participan en programas de formación en liderazgo y gestión educativa.","Fórmula de cálculo":"CDLA = (NLC / TL) x 100","Actividad":"Ejecutar el programa y registrar a los líderes capacitados","Responsable":"Dirección de Talento Humano"},{"@odata.etag":"","ItemInternalId":"4fab4376-900e-4f45-a1ab-c617ef9f07ed","Variable":"Estrategia y Liderazgo Institucional","Indicador":"Evaluación del Impacto de la Estrategia Institucional","Descripción Indicador":"Evaluación del impacto real de la estrategia institucional en el desarrollo académico, investigación y servicios a la comunidad.","Fórmula de cálculo":"ILOE = (Objetivos estratégicos con logro ≥ meta / Total de objetivos estratégicos evaluados) x 100, complementado con análisis cualitativo","Actividad":"Diseñar la metodología de evaluación de impacto de la estrategia","Responsable":"Dirección de Gestión Estrategica"},{"@odata.etag":"","ItemInternalId":"c96579a6-7767-4fc2-99e2-9125691498ad","Variable":"Estrategia y Liderazgo Institucional","Indicador":"Evaluación del Impacto de la Estrategia Institucional","Descripción Indicador":"Evaluación del impacto real de la estrategia institucional en el desarrollo académico, investigación y servicios a la comunidad.","Fórmula de cálculo":"ILOE = (Objetivos estratégicos con logro ≥ meta / Total de objetivos estratégicos evaluados) x 100, complementado con análisis cualitativo","Actividad":"Elaborar el informe de evaluación de impacto de la estrategia","Responsable":"Dirección de Gestión Estrategica"},{"@odata.etag":"","ItemInternalId":"df0b3a26-7c71-47df-8490-79613de804f6","Variable":"Estrategia y Liderazgo Institucional","Indicador":"Innovación en la Gestión Institucional","Descripción Indicador":"Número de iniciativas innovadoras implementadas en la gestión académica y administrativa para mejorar la eficiencia y efectividad de la universidad.","Fórmula de cálculo":"NIGI = Σ iniciativas innovadoras implementadas en la gestión académica y administrativa con mejora medida","Actividad":"Crear el banco de iniciativas de innovación en la gestión","Responsable":"Dirección de Gestión Estrategica\nRectorado"},{"@odata.etag":"","ItemInternalId":"0719c4f8-7da1-4e67-b0db-b7e5dc245e66","Variable":"Estrategia y Liderazgo Institucional","Indicador":"Innovación en la Gestión Institucional","Descripción Indicador":"Número de iniciativas innovadoras implementadas en la gestión académica y administrativa para mejorar la eficiencia y efectividad de la universidad.","Fórmula de cálculo":"NIGI = Σ iniciativas innovadoras implementadas en la gestión académica y administrativa con mejora medida","Actividad":"Implementar y medir iniciativas de innovación en la gestión","Responsable":"Dirección de Gestión Estrategica\nRectorado"},{"@odata.etag":"","ItemInternalId":"d4095098-31c7-4784-a274-5439cb0ad823","Variable":"Factores Transversales de Contexto Andino","Indicador":"Grado de Participación en Redes de Integración Regional","Descripción Indicador":"Participación de la universidad en redes o alianzas de integración andina que promuevan la colaboración académica y el desarrollo regional.","Fórmula de cálculo":"NRIR = Σ redes de integración andina o regional en las que la universidad participa activamente","Actividad":"Inventariar las redes andinas y regionales","Responsable":"Dirección de Relaciones Internacionales"},{"@odata.etag":"","ItemInternalId":"465b5ec0-0022-43e7-86b4-171ddc43eda6","Variable":"Factores Transversales de Contexto Andino","Indicador":"Grado de Participación en Redes de Integración Regional","Descripción Indicador":"Participación de la universidad en redes o alianzas de integración andina que promuevan la colaboración académica y el desarrollo regional.","Fórmula de cálculo":"NRIR = Σ redes de integración andina o regional en las que la universidad participa activamente","Actividad":"Solicitar el ingreso a la Red Andina de Universidades Acreditadas y a otras redes andinas","Responsable":"Rectorado\nVicerrectorado General"},{"@odata.etag":"","ItemInternalId":"4791e3fd-c5af-4102-8fbf-9a3d683a35da","Variable":"Factores Transversales de Contexto Andino","Indicador":"Programas Académicos con Enfoque Territorial","Descripción Indicador":"Porcentaje de programas académicos que incluyen proyectos o prácticas vinculadas c